[Desktop Entry]
Name=Zen Browser
Name[en]=Zen Browser
Comment=The Zen Web Browser
Comment[en]=The Zen Web Browser
Exec=/opt/zen/zen %u
Icon=/usr/share/icons/zen-browser.svg
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/vnd.mozilla.xul+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=zen
Keywords=web;browser;internet;firefox;
